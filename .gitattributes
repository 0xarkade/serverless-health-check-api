# Force LF everywhere. CRLF in a shell script breaks the shebang on Linux CI runners.
* text=auto eol=lf

*.sh     text eol=lf
*.py     text eol=lf
*.tf     text eol=lf
*.tfvars text eol=lf
*.hcl    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.json   text eol=lf
*.md     text eol=lf

*.zip    binary
